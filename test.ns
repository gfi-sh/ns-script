println "hey there buddy. yes you BUDDY"
println "every time you say 67. i will get mad. don't say it."

set anger to 0

while anger < 100
  prompt "scream at me: " -> u

  if u == "67"
    repeat 5
      increment anger

    print "(You have made him "
    print anger
    println "% angry.)"

repeat 1000000000
  print "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
